--- /dev/null
+++ b/tools/msl-introspect-test.cpp
@@ -0,0 +1,141 @@
+// msl-introspect-test.cpp — unit test for get_msl_interface_struct_members.
+//
+// Compiles a SPIR-V module under the same MSL options AppGL's runtime uses
+// for tess-as-compute, then dumps the canonical interface struct layout
+// for the requested storage class. Exit code 0 on success (sanity check
+// in get_msl_interface_struct_members itself fires on layout corruption).
+//
+// Usage:
+//   msl-introspect-test <spirv-file> <stage> <storage> [patch]
+//     stage    : vert | tesc | tese | frag
+//     storage  : in | out
+//     patch    : 'patch' to query per-patch interface (default per-vertex)
+//
+// Build (after building the main spirv-cross target):
+//   c++ -std=c++11 -O2 -I. -o tools/msl-introspect-test \
+//       tools/msl-introspect-test.cpp libspirv-cross.a
+
+#include "spirv_msl.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+using namespace spirv_cross;
+
+static std::vector<uint32_t> read_spirv(const char *path)
+{
+	std::ifstream f(path, std::ios::binary);
+	if (!f)
+	{
+		fprintf(stderr, "msl-introspect-test: cannot open %s\n", path);
+		std::exit(2);
+	}
+	std::vector<char> bytes((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+	if (bytes.size() % 4 != 0)
+	{
+		fprintf(stderr, "msl-introspect-test: %s is not a valid SPIR-V (length %% 4 != 0)\n", path);
+		std::exit(2);
+	}
+	std::vector<uint32_t> words(bytes.size() / 4);
+	std::memcpy(words.data(), bytes.data(), bytes.size());
+	return words;
+}
+
+static const char *base_type_name(SPIRType::BaseType t)
+{
+	switch (t)
+	{
+	case SPIRType::Float: return "float";
+	case SPIRType::Half: return "half";
+	case SPIRType::Int: return "int";
+	case SPIRType::UInt: return "uint";
+	case SPIRType::Short: return "short";
+	case SPIRType::UShort: return "ushort";
+	case SPIRType::Boolean: return "bool";
+	case SPIRType::Double: return "double";
+	case SPIRType::Int64: return "int64";
+	case SPIRType::UInt64: return "uint64";
+	case SPIRType::Struct: return "struct";
+	default: return "unknown";
+	}
+}
+
+int main(int argc, char **argv)
+{
+	if (argc < 4)
+	{
+		fprintf(stderr, "Usage: %s <spirv-file> <vert|tesc|tese|frag> <in|out> [patch]\n", argv[0]);
+		return 1;
+	}
+
+	const char *spv_path = argv[1];
+	const std::string stage = argv[2];
+	const std::string storage_arg = argv[3];
+	const bool patch = (argc >= 5 && std::string(argv[4]) == "patch");
+
+	StorageClass storage =
+	    (storage_arg == "in") ? StorageClassInput :
+	    (storage_arg == "out") ? StorageClassOutput :
+	                             StorageClassMax;
+	if (storage == StorageClassMax)
+	{
+		fprintf(stderr, "msl-introspect-test: bad storage '%s' (expected 'in' or 'out')\n", argv[3]);
+		return 1;
+	}
+
+	auto spirv = read_spirv(spv_path);
+	CompilerMSL compiler(spirv.data(), spirv.size());
+
+	// Match AppGL runtime's option set for tess-as-compute (matches Diff A
+	// finding: capture_output_to_buffer pairs with tess_evaluation_as_compute).
+	CompilerMSL::Options opts;
+	opts.msl_version = 30000;
+	opts.multi_patch_workgroup = true;
+	opts.raw_buffer_tese_input = true;
+	if (stage == "tese")
+	{
+		opts.tess_evaluation_as_compute = true;
+		opts.capture_output_to_buffer = true;
+		opts.tese_input_patch_vertices = 2;
+	}
+	if (stage == "vert")
+		opts.vertex_for_tessellation = true;
+	compiler.set_msl_options(opts);
+
+	// compile() must run before get_msl_interface_struct_members reads valid IDs.
+	auto msl = compiler.compile();
+	(void)msl;
+
+	auto layout = compiler.get_msl_interface_layout(storage, patch);
+
+	printf("# %s %s%s — %zu members, struct_size=%u (unpadded_end=%u align=%u)\n",
+	       spv_path,
+	       storage == StorageClassInput ? "INPUT" : "OUTPUT",
+	       patch ? " (patch)" : "",
+	       layout.members.size(),
+	       layout.struct_size, layout.unpadded_end, layout.struct_alignment);
+
+	for (size_t i = 0; i < layout.members.size(); ++i)
+	{
+		const auto &m = layout.members[i];
+		std::string loc_str = m.location == ~0u ? "    -" : std::to_string(m.location);
+		std::string blt_str = m.is_builtin ? std::to_string((int)m.builtin) : "    -";
+		std::string vec_str = m.vecsize > 1 ? ("v" + std::to_string(m.vecsize)) : "";
+		std::string arr_str = m.array_size > 0 ? ("[" + std::to_string(m.array_size) + "]") : "";
+		printf("  [%zu] name=%-28s loc=%5s comp=%u  builtin=%5s  type=%s%u%s%s  off=%u sz=%u\n",
+		       i, m.name.c_str(),
+		       loc_str.c_str(),
+		       m.component,
+		       blt_str.c_str(),
+		       base_type_name(m.base_type), m.bit_width,
+		       vec_str.c_str(),
+		       arr_str.c_str(),
+		       m.offset, m.size);
+	}
+
+	return 0;
+}
