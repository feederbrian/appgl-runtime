+	// Maps a flattened interface-member index back onto the nested local composite.
+	// Flattening order is the GLSL declaration walk: outermost array index varies
+	// slowest, matrix column fastest — so decompose column first, then array
+	// dimensions innermost-first, and emit subscripts outermost-first to match the
+	// MSL nesting (spvUnsafeArray<spvUnsafeArray<T, inner>, outer>).
+	//
+	// NOTE: BY-VALUE CAPTURE IS LOAD-BEARING. This lambda is copied into the
+	// fixup_hooks_in/out closures below, which run long after this function has
+	// returned; capturing array_dims / array_matrix_columns by reference reads
+	// dead stack slots and silently degrades to a single-subscript expression.
+	auto flat_index_expr = [array_dims, array_matrix_columns](uint32_t idx) -> string {
+		if (array_dims.empty())
+			return join("[", idx, "]");
+
+		uint32_t rest = idx;
+		uint32_t col = 0;
+		if (array_matrix_columns)
+		{
+			col = rest % array_matrix_columns;
+			rest /= array_matrix_columns;
+		}
+
+		SmallVector<uint32_t> subs;
+		for (uint32_t d = 0; d < uint32_t(array_dims.size()); d++)
+		{
+			uint32_t n = array_dims[d] ? array_dims[d] : 1u;
+			subs.push_back(rest % n);
+			rest /= n;
+		}
+
+		string expr;
+		for (size_t k = subs.size(); k-- > 0;)
+			expr += join("[", subs[k], "]");
+		if (array_matrix_columns)
+			expr += join("[", col, "]");
+		return expr;
