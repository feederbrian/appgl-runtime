+	set<SPIRVariable>(var_id, type_ptr_id, StorageClassOutput);
+	set_decoration(var_id, DecorationBuiltIn, BuiltInPosition);
+	set_name(var_id, "gl_Position");
+	mark_implicit_builtin(StorageClassOutput, BuiltInPosition, var_id);
